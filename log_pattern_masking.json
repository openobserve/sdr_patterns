{
  "version": 1,
  "rules": [
    {
      "label": "URL",
      "note": "Enclosing identifiers go first so a date or MAC inside them cannot split them.",
      "regex": "[A-Za-z][A-Za-z0-9+.-]{1,15}:(?://|\\\\/\\\\/)[^\\s\"'<>|`]+",
      "validator": "url",
      "url_end": true,
      "only_with": ["://", ":\\/\\/"]
    },
    {
      "label": "ID",
      "regex": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
    },
    {
      "label": "EMAIL",
      "regex": "[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,63}",
      "validator": "email"
    },
    {
      "label": "TIMESTAMP",
      "regex": "[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:[.,][0-9]{1,9})?(?:Z|[+-][0-9]{2}:?[0-9]{2})?",
      "validator": "date_time"
    },
    {
      "label": "TIMESTAMP",
      "regex": "[0-9]{4}/[0-9]{2}/[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.,][0-9]{1,9})?",
      "validator": "date_time"
    },
    {
      "label": "TIMESTAMP",
      "regex": "[0-9]{2}/[A-Z][a-z]{2}/[0-9]{4}:[0-9]{2}:[0-9]{2}:[0-9]{2}(?: [+-][0-9]{4})?",
      "validator": "clf"
    },
    {
      "label": "TIMESTAMP",
      "note": "A trailing year needs the leading weekday, or a syslog line's next number would be eaten.",
      "regex": "(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun),? (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) {1,2}[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.,][0-9]{1,9})?(?: (?:[A-Z]{3,4} )?(?:19|20)[0-9]{2})?|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) {1,2}[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.,][0-9]{1,9})?",
      "validator": "named_month"
    },
    {
      "label": "TIMESTAMP",
      "regex": "(?:(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun), )?[0-9]{1,2} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9]{4} [0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?: (?:[+-][0-9]{4}|GMT|UTC|UT))?",
      "validator": "named_month"
    },
    {
      "label": "TIMESTAMP",
      "regex": "[0-9]{4}[-/][0-9]{2}[-/][0-9]{2}",
      "validator": "date"
    },
    {
      "label": "UUID",
      "regex": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
    },
    {
      "label": "IP",
      "note": "Ahead of IPv4 so the dotted tail of ::ffff:10.0.0.1 stays inside the address.",
      "regex": "\\[(?:[0-9A-Fa-f]{0,4}:){2,7}(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}|[0-9A-Fa-f]{0,4})\\]:[0-9]{1,5}|(?:[0-9A-Fa-f]{0,4}:){2,7}(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}|[0-9A-Fa-f]{0,4})",
      "validator": "ipv6",
      "dot_guard": "left",
      "shrink_at_colon": true
    },
    {
      "label": "IP",
      "regex": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?::[0-9]{1,5})?",
      "validator": "ipv4",
      "dot_guard": "both",
      "shrink_at_colon": true
    },
    {
      "label": "MAC",
      "note": "Ahead of TIME, or 00:11:22 of a MAC address is taken as a time of day.",
      "regex": "[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}|[0-9A-Fa-f]{2}(?:-[0-9A-Fa-f]{2}){5}"
    },
    {
      "label": "TIME",
      "regex": "[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.,][0-9]{1,9})?",
      "validator": "time"
    },
    {
      "label": "DOMAIN",
      "regex": "(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}",
      "validator": "domain",
      "dot_guard": "both"
    },
    {
      "label": "VERSION",
      "regex": "v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+.][0-9A-Za-z.-]*[0-9A-Za-z])?"
    },
    {
      "label": "DURATION",
      "note": "Units are case-sensitive, so 5m stays a duration and 5M a size.",
      "regex": "(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+",
      "dot_guard": "both"
    },
    {
      "label": "SIZE",
      "regex": "[0-9]+(?:\\.[0-9]+)?(?:[KMGTPE]i?B|[KMGTPE]i|[KMGTP]|kB|B)",
      "dot_guard": "both"
    },
    {
      "label": "HEX",
      "regex": "0[xX][0-9a-fA-F]+|[0-9a-fA-F]{7,}",
      "validator": "hex",
      "dot_guard": "both"
    },
    {
      "label": "ID",
      "regex": "[A-Za-z0-9]{16,}",
      "validator": "id",
      "dot_guard": "both"
    },
    {
      "label": "NUM",
      "regex": "-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
      "dot_guard": "both",
      "signed": true
    }
  ],
  "generic_tlds": ["com", "net", "org", "io", "ai", "dev", "app", "cloud", "co", "internal", "local", "svc", "cluster", "edu", "gov", "biz", "tech"],
  "file_extensions": ["ts", "js", "py", "rb", "go", "rs", "md", "gz", "xz", "bz", "so", "db", "pb", "sh", "cc", "hh", "pl", "pm", "el", "ml", "rc", "in", "cs", "kt", "hs", "ex", "fs", "jl", "mk"],
  "asset_extensions": ["png", "jpg", "jpeg", "gif", "svg", "webp", "avif", "ico", "css", "js", "mjs", "map", "json", "html", "htm", "txt", "log", "xml", "pdf", "woff", "woff2", "ttf"]
}
