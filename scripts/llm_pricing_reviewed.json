  "ignore": [
    {
      "pattern": "^qwen-(?:turbo|coder)(?:$|-)",
      "reason": "Not in the Model Studio international (Singapore) price tables."
    },
    {
      "pattern": "^qwq-plus",
      "reason": "Not in the Model Studio international (Singapore) price tables."
    },
    {
      "pattern": "^qwen3-(?:next|vl)-",
      "reason": "Open-weight ids; not in the Model Studio international price tables."
    },
    {
      "pattern": "^qwen3\\.8-omni",
      "reason": "Omni (audio/video) model; output price depends on modality."
    },
    {
      "pattern": "^command-(?:a-03-2025|r-08-2024|r7b-)",
      "reason": "Cohere publishes no per-token price for these models."
    },
    {
      "pattern": "^embed-",
      "reason": "Cohere publishes no per-token embed prices (Embed 5 is priced per hosted instance)."
    },
    {
      "pattern": "^deepseek-(?:coder|v3\\.2)$",
      "reason": "No longer on DeepSeek's pricing page."
    },
    {
      "pattern": "^gemini-exp-",
      "reason": "Experimental id with no published price."
    },
    {
      "pattern": "^gemini-gemma-",
      "reason": "Not on the Gemini API pricing page."
    },
    {
      "pattern": "^gemini-omni-",
      "reason": "Video generation model; output price depends on modality."
    },
    {
      "pattern": "^gemini-pro-latest$",
      "reason": "No official page states which model the alias points to now."
    },
    {
      "pattern": "^minimax-m2",
      "reason": "MiniMax M2 / M2.1 / M2.5 are no longer on the pricing page."
    },
    {
      "pattern": "^(?:codestral-mamba|devstral|magistral|pixtral)-",
      "reason": "Retired per Mistral's deprecated-models table."
    },
    {
      "pattern": "^mistral-(?:code|vibe-cli)-",
      "reason": "Not listed on any Mistral page."
    },
    {
      "pattern": "^mistral-(?:small|tiny)$",
      "reason": "Not documented as an alias of a current model."
    },
    {
      "pattern": "^moonshot-v1-auto$",
      "reason": "No longer on the Kimi pricing page."
    },
    {
      "pattern": "^gpt-5-chat$",
      "reason": "Not an OpenAI model id (Azure deployment name); gpt-5-chat-latest is priced."
    },
    {
      "pattern": "^glm-5-code$",
      "reason": "No longer on the Z.ai pricing page."
    }
  ],
