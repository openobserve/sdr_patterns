{
  "id": "hosts",
  "version": "1.1.0",
  "title": "Hosts",
  "description": "The host metrics dashboard for servers and virtual machines.",
  "logo": "images/common/linux.svg",
  "collector_route": "ingestFromLinux",
  "folder": {
    "name": "Hosts",
    "description": "Installed by the Hosts starter pack"
  },
  "detect": {
    "metric_names": [
      [
        "system_cpu_time",
        "node_cpu_seconds_total"
      ],
      [
        "system_memory_usage",
        "node_memory_MemAvailable_bytes"
      ],
      [
        "system_filesystem_usage",
        "node_filesystem_avail_bytes"
      ]
    ]
  },
  "dashboards": [
    {
      "id": "host_metrics",
      "title": "Host Metrics",
      "bundled": "host_metrics",
      "importer": "host_metrics"
    }
  ],
  "alerts": {
    "core": [
      "opentelemetry/host_high_cpu_load_otel",
      "opentelemetry/host_out_of_memory_otel",
      "opentelemetry/host_out_of_disk_space_otel",
      "opentelemetry/host_stopped_reporting"
    ],
    "more": [
      "opentelemetry/host_disk_may_fill_in_24_hours_otel",
      "opentelemetry/host_cpu_load_saturation_otel"
    ]
  },
  "saved_views": [],
  "paused_impact": "a host runs out of CPU, memory or disk, or stops reporting"
}
